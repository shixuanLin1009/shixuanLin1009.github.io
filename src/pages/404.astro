---
import Base from '../layouts/Base.astro';
---

<Base locale="en" title="404" noindex alternates={false}>
  <div class="container-page flex flex-col items-center py-28 text-center">
    <p class="font-mono text-sm text-accent">error 404 · page not found</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-1 text-muted">找不到頁面</p>
    <p class="mt-6 max-w-md text-muted">The page you are looking for does not exist or has moved. 你要找的頁面不存在或已經搬家了。</p>
    <div class="mt-8 flex gap-2">
      <a href="/" class="btn-primary">Home</a>
      <a href="/zh/" class="btn">中文首頁</a>
    </div>
  </div>
</Base>
