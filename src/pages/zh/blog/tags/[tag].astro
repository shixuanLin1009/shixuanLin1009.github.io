---
import { tagSlug } from '../../../../lib/blog';
import { getListedPosts } from '../../../../lib/content';
import TagView from '../../../../views/TagView.astro';

export async function getStaticPaths() {
  const tags = new Set((await getListedPosts()).flatMap((p) => p.data.tags.map(tagSlug)));
  return [...tags].map((tag) => ({ params: { tag } }));
}
---

<TagView locale="zh-TW" tag={Astro.params.tag} />
