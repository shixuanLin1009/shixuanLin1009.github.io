---
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { blogCategories, categoryLabel, tagCounts, tagSlug } from '../lib/blog';
import { getListedPosts } from '../lib/content';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const posts = await getListedPosts();
const categories = blogCategories(posts);
const tags = tagCounts(posts);
---

<Base locale={locale} title={t(locale, 'blog.title')} description={t(locale, 'blog.intro')} searchable={false}>
  <div class="container-page max-w-4xl py-12 sm:py-16">
    <header class="mb-8">
      <p class="eyebrow mb-2">~/blog</p>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t(locale, 'blog.title')}</h1>
          <p class="mt-3 text-muted">{t(locale, 'blog.intro')}</p>
        </div>
        <a href="/rss.xml" class="btn !text-xs">
          <Icon name="rss" size={13} />
          {t(locale, 'blog.rss')}
        </a>
      </div>
    </header>

    <div class="mb-4 flex flex-wrap gap-1.5 border-b border-line pb-4" role="tablist">
      <button type="button" class="cat-tab rounded-md px-3 py-1.5 text-sm transition" data-cat="" aria-selected="true">
        {t(locale, 'blog.all')} <span class="font-mono text-xs text-muted">{posts.length}</span>
      </button>
      {
        categories.map((c) => (
          <button type="button" class="cat-tab rounded-md px-3 py-1.5 text-sm transition" data-cat={c} aria-selected="false">
            {categoryLabel(c, locale)}{' '}
            <span class="font-mono text-xs text-muted">{posts.filter((p) => p.data.category === c).length}</span>
          </button>
        ))
      }
    </div>

    <PostList posts={posts} locale={locale} />

    {
      tags.length > 0 && (
        <section class="mt-12 border-t border-line pt-8">
          <p class="eyebrow mb-4">tags</p>
          <div class="flex flex-wrap gap-2">
            {tags.map(([tag, count]) => (
              <a href={localePath(`/blog/tags/${tagSlug(tag)}/`, locale)} class="chip !text-xs transition hover:border-accent hover:text-accent">
                #{tag} <span class="ml-1 opacity-60">{count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .cat-tab[aria-selected='true'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }
  .cat-tab[aria-selected='false'] {
    color: var(--muted);
  }
  .cat-tab[aria-selected='false']:hover {
    color: var(--fg);
  }
</style>

<script>
  // Category tabs filter the list client-side; `?c=paper` deep-links to a tab.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.cat-tab')];
  const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
  const select = (cat: string) => {
    for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.cat === cat));
    for (const row of rows) row.hidden = !!cat && row.dataset.category !== cat;
    const url = new URL(location.href);
    cat ? url.searchParams.set('c', cat) : url.searchParams.delete('c');
    history.replaceState(null, '', url);
  };
  for (const tab of tabs) tab.addEventListener('click', () => select(tab.dataset.cat ?? ''));
  const initial = new URL(location.href).searchParams.get('c');
  if (initial && tabs.some((t) => t.dataset.cat === initial)) select(initial);
</script>
