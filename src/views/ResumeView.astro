---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { getResumeData } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import { blockMd, inlineMd, protectedHref } from '../lib/markdown';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const resume = await getResumeData(locale, Astro.site);
---

<Base locale={locale} title={t(locale, 'resume.title')}>
  <div class="container-page max-w-4xl py-12 sm:py-16">
    <header class="mb-10 flex flex-col gap-6 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow mb-2">~/resume</p>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{resume.name}</h1>
        <p class="mt-2 text-lg text-muted">{resume.headline}</p>
        <ul class="mt-2 flex flex-wrap gap-x-3 font-mono text-xs text-muted">
          {
            resume.contact.map((c) => (
              <li>
                <a {...protectedHref(c.url)} class="inline-block py-1.5 transition hover:text-accent">
                  {c.url.startsWith('mailto:') ? c.label.replace('@', ' [at] ') : c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <a href="/cv/Shixuan_Lin_Resume_EN.pdf" class:list={[locale === 'en' ? 'btn-primary' : 'btn']} download>
          <Icon name="download" size={15} />
          {t(locale, 'resume.downloadEn')}
        </a>
        <a href="/cv/Shixuan_Lin_Resume_ZH.pdf" class:list={[locale === 'zh-TW' ? 'btn-primary' : 'btn']} download>
          <Icon name="download" size={15} />
          {t(locale, 'resume.downloadZh')}
        </a>
      </div>
    </header>

    <div class="space-y-12">
      {
        resume.sections.map((section) => (
          <section class="grid gap-4 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <h2 class="eyebrow pt-1 sm:sticky sm:top-20 sm:self-start">{section.title}</h2>
            <div>
              {section.kind === 'summary' && (
                <div class="space-y-3 leading-relaxed text-muted [&_strong]:text-fg" set:html={blockMd(section.text)} />
              )}

              {section.kind === 'entries' && (
                <div class="space-y-8">
                  {section.items.map((item) => (
                    <div>
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <h3 class="font-semibold leading-snug">
                          {item.url ? (
                            <a href={item.url} class="transition hover:text-accent" target="_blank" rel="noopener">
                              {item.title}
                            </a>
                          ) : (
                            item.title
                          )}
                        </h3>
                        {item.dates && <span class="shrink-0 font-mono text-xs text-muted">{item.dates}</span>}
                      </div>
                      {(item.subtitle || item.location) && (
                        <div class="mt-0.5 flex flex-wrap justify-between gap-x-4 text-sm text-muted">
                          {item.subtitle && <span class="italic">{item.subtitle}</span>}
                          {item.location && <span>{item.location}</span>}
                        </div>
                      )}
                      {item.detail && <p class="mt-1.5 text-sm text-muted">{item.detail}</p>}
                      {item.bullets.length > 0 && (
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed marker:text-accent/60 [&_strong]:font-semibold">
                          {item.bullets.map((b) => (
                            <li set:html={inlineMd(b)} />
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {section.kind === 'publications' && (
                <ol class="space-y-4 text-sm">
                  {section.items.map((p) => (
                    <li>
                      <p class="font-medium">{p.title}</p>
                      <p class="text-muted">
                        {p.authors.map((a, i) => (
                          <>
                            {i > 0 && ', '}
                            <span class:list={[a.self && 'font-semibold text-fg']}>{a.name}</span>
                          </>
                        ))}
                        {' · '}
                        <span class="italic">{p.venue}</span> ({p.status}){p.note && ` · ${p.note}`}
                      </p>
                    </li>
                  ))}
                </ol>
              )}

              {section.kind === 'skills' && (
                <dl class="grid gap-3 text-sm sm:grid-cols-[9rem_1fr]">
                  {section.items.map((g) => (
                    <>
                      <dt class="font-medium">{g.group}</dt>
                      <dd class="flex flex-wrap gap-1.5">
                        {g.items.map((s) => (
                          <span class="rounded-md border border-line bg-surface px-2 py-0.5">{s}</span>
                        ))}
                      </dd>
                    </>
                  ))}
                </dl>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
