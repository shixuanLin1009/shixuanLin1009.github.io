---
import Icon from './Icon.astro';

interface Props {
  seed: string;
  icon?: string;
  label?: string;
  class?: string;
}
const { seed, icon = 'sparkles', label, class: className = '' } = Astro.props;

// Deterministic "attention map" artwork for items without a cover image.
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
const rand = () => {
  h = Math.imul(h ^ (h >>> 15), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  return ((h ^= h >>> 16) >>> 0) / 4294967296;
};
const cols = 12;
const rows = 6;
const peakX = rand() * cols;
const peakY = rand() * rows;
const cells: { x: number; y: number; o: number }[] = [];
for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    const d = Math.hypot((x - peakX) / 4, (y - peakY) / 2.2);
    const o = Math.max(0.04, Math.min(0.9, Math.exp(-d * d) * 0.85 + rand() * 0.18));
    cells.push({ x, y, o });
  }
}
const angle = Math.floor(rand() * 360);
---

<div
  class:list={['relative overflow-hidden', className]}
  style={`background: linear-gradient(${angle}deg, color-mix(in oklab, var(--accent) 16%, var(--surface)), color-mix(in oklab, var(--accent-2) 14%, var(--surface)));`}
>
  <svg viewBox={`0 0 ${cols * 10} ${rows * 10}`} preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
    {cells.map((c) => <rect x={c.x * 10 + 1} y={c.y * 10 + 1} width="8" height="8" rx="1.6" fill="var(--accent)" opacity={c.o.toFixed(2)} />)}
  </svg>
  <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-surface/10 to-transparent"></div>
  <div class="absolute bottom-3 left-3 flex items-center gap-2 rounded-md bg-surface/80 px-2 py-1 font-mono text-[11px] text-muted backdrop-blur">
    <Icon name={icon} size={13} class="text-accent" />
    {label && <span>{label}</span>}
  </div>
</div>
