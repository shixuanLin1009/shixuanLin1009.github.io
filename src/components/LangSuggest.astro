---
import { switchLocalePath, t } from '../lib/i18n';

const target = switchLocalePath(Astro.url, 'zh-TW');
---

<!-- Shown on English pages to visitors whose browser prefers Chinese and who haven't chosen a language. -->
<div class="lang-suggest hidden border-b border-line bg-accent-soft">
  <div class="container-page flex items-center gap-3 py-2 text-sm">
    <span class="text-muted">{t('en', 'lang.suggest')}</span>
    <a href={target} class="link font-medium" data-lang="zh-TW">{t('en', 'lang.suggestAction')}</a>
    <button type="button" class="ml-auto font-mono text-xs text-muted hover:text-fg" aria-label="Dismiss">✕</button>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('.lang-suggest');
  let chosen: string | null = null;
  try {
    chosen = localStorage.getItem('lang');
  } catch {}
  if (bar && !chosen && navigator.languages.some((l) => l.toLowerCase().startsWith('zh'))) {
    bar.classList.remove('hidden');
    const remember = (lang: string) => {
      try {
        localStorage.setItem('lang', lang);
      } catch {}
    };
    bar.querySelector('a')?.addEventListener('click', () => remember('zh-TW'));
    bar.querySelector('button')?.addEventListener('click', () => {
      remember('en');
      bar.remove();
    });
  }
</script>
