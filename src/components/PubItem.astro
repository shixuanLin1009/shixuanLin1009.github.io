---
import type { Publication } from '../lib/content';
import { localePath, t, type Locale, type UiKeyOf } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  pub: Publication;
  locale: Locale;
  showAbstract?: boolean;
}
const { pub, locale, showAbstract = true } = Astro.props;

const linkLabels: Record<string, string> = {
  pdf: 'PDF',
  arxiv: 'arXiv',
  code: 'Code',
  project: 'Project',
  video: 'Video',
  slides: 'Slides',
  doi: 'DOI',
};
const links = Object.entries(pub.links).filter(([, url]) => !!url) as [string, string][];
const statusKey = `pub.status.${pub.status}` as UiKeyOf<'pub.status.'>;
const pending = pub.status === 'submitted' || pub.status === 'under-review' || pub.status === 'preprint';
---

<article class="pub-item group grid gap-3 sm:grid-cols-[7rem_1fr] sm:gap-5">
  <div class="flex items-start gap-2 sm:flex-col">
    <span class="inline-flex min-w-[4.5rem] justify-center rounded-md bg-accent-soft px-2 py-1 font-mono text-xs font-semibold text-accent">
      {pub.venueShort ?? pub.venue} {pub.year}
    </span>
    <span class:list={['chip', pending ? 'border-dashed' : 'border-accent/40 text-accent']}>{t(locale, statusKey)}</span>
  </div>
  <div class="min-w-0">
    <h3 class="font-semibold leading-snug tracking-tight">
      {
        pub.showcase ? (
          <a href={localePath(`/work/${pub.showcase}/`, locale)} class="transition hover:text-accent">
            {pub.title}
          </a>
        ) : (
          pub.title
        )
      }
    </h3>
    <p class="mt-1 text-sm text-muted">
      {
        pub.authorList.map((a, i) => (
          <>
            {i > 0 && ', '}
            <span class:list={[a.self && 'font-semibold text-fg underline decoration-accent/50 underline-offset-4']}>
              {a.name}
              {a.equal && '*'}
            </span>
          </>
        ))
      }
    </p>
    <p class="mt-0.5 text-sm text-muted italic">{pub.venue}{pub.note && <span class="not-italic"> · {pub.note}</span>}</p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      {
        links.map(([key, url]) => (
          <a href={url} class="btn !px-2 !py-0.5 font-mono !text-xs" target="_blank" rel="noopener">
            {linkLabels[key] ?? key}
            <Icon name="arrow-up-right" size={12} />
          </a>
        ))
      }
      {
        pub.bibtex && (
          <button type="button" class="btn bibtex-copy !px-2 !py-0.5 font-mono !text-xs" data-bibtex={pub.bibtex} data-copied={t(locale, 'pub.copied')}>
            <Icon name="copy" size={12} />
            <span>{t(locale, 'pub.copyBibtex')}</span>
          </button>
        )
      }
      {
        showAbstract && pub.abstract && (
          <details class="w-full text-sm text-muted [&[open]>summary]:text-fg">
            <summary class="w-fit cursor-pointer font-mono text-xs transition hover:text-accent">Abstract</summary>
            <p class="mt-2 leading-relaxed">{pub.abstract}</p>
          </details>
        )
      }
    </div>
  </div>
</article>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.bibtex-copy')) {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.bibtex ?? '');
      const label = btn.querySelector('span');
      if (!label) return;
      const original = label.textContent;
      label.textContent = btn.dataset.copied ?? 'Copied';
      setTimeout(() => (label.textContent = original), 1500);
    });
  }
</script>
